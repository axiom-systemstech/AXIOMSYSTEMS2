struct Point {
    x: Int
    y: Int
}

fn calculate(a: Int, b: Float) -> Float {
    let values: Int[] = [1, 2, 3]
    let point: Point = Point { x: 10, y: 20 }
    let total: Int = values[0] + point.x
    if total >= 10 && true {
        print("ok")
    } else {
        print("no")
    }
    while total < 20 {
        print(total)
        break
    }
    return b + 1.0
}

fn main() {
    calculate(4, 2.5)
}